{
  "name": "dsh-boot-animation-sound",
  "version": "1.1.1",
  "description": "DSH 开机动画：铺满窗口播放一段视频，声音不需要全屏。触发时机（启动应用/页面刷新/新对话/任意会话）与播放频率（每次/每天一次/只播一次/限播 N 次）都可自选。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "boot-animation",
    "startup-animation",
    "splash",
    "sound",
    "audio",
    "autoplay"
  ],
  "license": "MIT",
  "author": "LSY (个人创作)",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "media",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "verify"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "node verify/check-media.mjs && node verify/host-verify.mjs && node verify/client-smoke.mjs",
    "verify:media": "node verify/check-media.mjs",
    "verify:host": "node verify/host-verify.mjs",
    "verify:client": "node verify/client-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2034126171/dsh-boot-animation-sound.git"
  },
  "homepage": "https://github.com/2034126171/dsh-boot-animation-sound#readme",
  "bugs": {
    "url": "https://github.com/2034126171/dsh-boot-animation-sound/issues"
  },
  "meta": {
    "title": "开机动画（免全屏出声）",
    "description": "铺满窗口播放一段视频，声音不需要全屏。触发时机可选：启动应用 / 页面刷新 / 新对话 / 任意会话；播放频率可选：每次 / 每天一次 / 只播一次 / 限播 N 次。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  }
}
